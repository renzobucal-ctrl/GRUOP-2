ADMIN.HTML
// Display orders kasama ang driver_name
document.getElementById('admin-orders-body').innerHTML = appData.orders.map(o => `
  <tr>
    <td>#${o.order_id}</td>
    <td>${o.customer_name}</td>
    <td>${o.barangay}</td>
    <td>${o.items_summary || '-'}</td>
    <td>₱${parseFloat(o.total_amount).toFixed(2)}</td>
    <td><strong>${o.driver_name || '<span style="color:#94a3b8">Unassigned</span>'}</strong></td>
    <td><span class="badge ${o.payment_status === 'Paid' ? 'paid' : 'unpaid'}">${o.payment_status}</span></td>
    <td><span class="badge ${o.delivery_status === 'Delivered' ? 'delivered' : (o.delivery_status === 'Out for delivery' ? 'transit' : 'pending')}">${o.delivery_status}</span></td>
  </tr>
`).join('');

// Pag-save ng bagong order
async function createOrder(e) {
  e.preventDefault();
  await fetch('api.php?action=create_order', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({
      customer_id: document.getElementById('ord-customer').value,
      product_id: document.getElementById('ord-product').value,
      quantity: document.getElementById('ord-qty').value,
      payment_status: document.getElementById('ord-payment').value
    })
  });
  loadData();
}



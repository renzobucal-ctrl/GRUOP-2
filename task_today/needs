PHP - $salarySql = "
    SELECT d.driver_id, d.full_name, d.daily_rate, d.per_delivery_rate,
           COUNT(o.order_id) AS completed_deliveries,
           (d.daily_rate + (COUNT(o.order_id) * d.per_delivery_rate)) AS estimated_pay
    FROM drivers d
    LEFT JOIN orders o ON o.driver_id = d.driver_id AND o.delivery_status = 'Delivered'
    GROUP BY d.driver_id
";


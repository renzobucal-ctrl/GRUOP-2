async function updateStock(id, price) {
  const stock = document.getElementById('stk-' + id).value;
  await fetch('api.php?action=save_product', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({ product_id: id, price: price, stock_qty: stock })
  });
  loadData();
}

    <td>₱${p.price}</td>
    <td><strong>${p.stock_qty}</strong></td>
    <td>
      <input type="number" id="stk-${p.product_id}" value="${p.stock_qty}" style="width:80px; display:inline-block;" />
      <button class="primary" onclick="updateStock(${p.product_id}, ${p.price})">Save</button>
    </td>
  </tr>

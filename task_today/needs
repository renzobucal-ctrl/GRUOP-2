PHP - $driversSql = "
    SELECT d.*,
        (
            SELECT CONCAT('#', o2.order_id, ' - ', c2.full_name, ' (', c2.barangay, ')')
            FROM orders o2
            INNER JOIN customers c2 ON c2.customer_id = o2.customer_id
            WHERE o2.driver_id = d.driver_id AND o2.delivery_status = 'Out for delivery'
            ORDER BY o2.order_id DESC LIMIT 1
        ) AS current_order
    FROM drivers d
    ORDER BY d.driver_id ASC
";
